# --- Secrets (generate on the VM: docker compose run --rm papertrade-api node dist/keygen.js) ---
# Dedicated wallet used ONLY for Papertrade. It signs session-key
# registrations (every ~27 days) and, later, withdrawals.
WALLET_PRIVATE_KEY=0x...
# Bearer token callers (e.g. Cassandrina) must send. 32+ chars.
API_TOKEN=

# --- Network exposure (compose only) ---
# The VM's Tailscale IP, so only the tailnet can reach the API, or its LAN IP
# together with infra/lan-allowlist.sh.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8787

# --- Trading mode ---
# false = every write is a dry-run (signed with a throwaway key, never sent).
LIVE_TRADING=false
# Re-register the session key automatically (live mode only).
AUTO_RENEW_SESSION=true
SESSION_RENEW_BEFORE_HOURS=72

# --- Risk limits (enforced before anything is signed) ---
# Papertrade's own minimum position value is $10,000 (margin × leverage).
MAX_MARGIN_USD=100
MAX_LEVERAGE=100
MAX_OPEN_POSITIONS=3
MAX_TOTAL_MARGIN_USD=300
DAILY_LOSS_LIMIT_USD=50
SNAPSHOT_MAX_AGE_MS=30000

# --- Historical 1-minute candles (BTC + ETH, Binance perps + Hyperliquid) ---
CANDLE_SYNC=true
# Days of Binance history kept before today (2-year backtest + 36 days look-back).
CANDLE_BACKFILL_DAYS=766
CANDLE_POLL_SECONDS=60
# BINANCE_FAPI_URL=https://fapi.binance.com/fapi/v1
# BINANCE_ARCHIVE_URL=https://data.binance.vision/data/futures/um/monthly/klines

# --- Endpoints (defaults are production) ---
# PAPERTRADE_ORIGIN=https://exchange.papertrade.xyz
# PAPERTRADE_BUILD_ID=            # optional fallback if bundle discovery fails
# HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
LOG_LEVEL=info
