{
  "name": "papertrade-api",
  "version": "0.1.0",
  "private": true,
  "description": "Programmatic read/write API for papertrade.xyz synthetic perps, run as a standalone service.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "keygen": "tsx src/keygen.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9",
    "viem": "2.56.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
